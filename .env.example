# ==============================================================================
# RENALYTICA ENVIRONMENT VARIABLES (TEMPLATE / EXAMPLE)
# Copy this file to .env and populate with your actual production secrets.
# ==============================================================================

# 1. Supabase (Database, Auth & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ADMIN_EMAIL=admin@renalytica.com
SUPABASE_ADMIN_PASSWORD=your_secure_password
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# 2. Firebase & Google Gemini API
FIREBASE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Resend (Transactional Email API)
RESEND_API_KEY=re_your_resend_api_key_here

# 4. Cloudflare R2 (S3-Compatible Object Storage & Asset Delivery)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# 5. GitHub Personal Access Token
GITHUB_TOKEN=ghp_your_github_personal_access_token

# 6. Flutterwave Payment Gateway (Commercial Settlement)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=your_encryption_key_here

# 7. Cal.com Enterprise Scheduling Flow
NEXT_PUBLIC_CAL_API_KEY=cal_live_your_cal_api_key_here
NEXT_PUBLIC_CAL_LINK=renalytica/30min

