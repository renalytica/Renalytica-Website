# ==============================================================================
# RENALYTICA PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Copy this to .env and fill in your actual credentials.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ─────────────────────────────────────────────
# 1. SUPABASE (Database / Auth / Storage)
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # anon/public key
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...       # service_role key
SUPABASE_ADMIN_EMAIL=renalytica@gmail.com

# ─────────────────────────────────────────────
# 2. FLUTTERWAVE PAYMENT GATEWAY
# ─────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_HASH=your-webhook-secret-hash  # Set in Flutterwave dashboard → Settings → Webhooks

# ─────────────────────────────────────────────
# 3. CLOUDFLARE (R2 Storage / Workers / DNS)
# ─────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=cfat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ─────────────────────────────────────────────
# 4. RESEND (Transactional Email)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# 5. FIREBASE / GEMINI (AI Features)
# ─────────────────────────────────────────────
FIREBASE_GEMINI_API_KEY=AIzaSy...

# ─────────────────────────────────────────────
# 6. SERVER CONFIGURATION
# ─────────────────────────────────────────────
PORT=8085
NODE_ENV=production
